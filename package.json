{
  "name": "scanandstock",
  "main": "expo-router/entry",
  "version": "1.0.7",
  "scripts": {
    "start": "expo start",
    "start:dev": "cp .env.development .env 2>nul || copy .env.development .env && expo start",
    "start:staging": "cp .env.staging .env 2>nul || copy .env.staging .env && expo start",
    "start:prod": "cp .env.production .env 2>nul || copy .env.production .env && expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings=0",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "axios": "1.20.0",
    "dotenv": "^17.2.3",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.16",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.0.2",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "react-native-svg-transformer": "^1.5.2",
    "typescript": "~6.0.3",
    "vitest": "^2.1.4"
  },
  "private": true
}
